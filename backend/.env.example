# Copy this file to .env and fill in real local values.
# .env itself must NEVER be committed — only this .example file is.

ENVIRONMENT=development

# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_university_cms

# Used later (Phase 3+) for JWT signing. Generate a real random value
# before that phase — this placeholder is not secure.
SECRET_KEY=dev-only-placeholder-change-me

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
