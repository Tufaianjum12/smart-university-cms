# Copy this file to .env and adjust if your backend runs elsewhere.
#
# IMPORTANT: Vite only exposes variables prefixed with VITE_, and it bakes
# them into the JavaScript bundle at build time. Anyone can view them in
# the browser. This is fine for a public API base URL, but this file must
# NEVER contain secrets (API keys, database passwords, JWT secrets) —
# those belong only in the backend's .env, never here.

VITE_API_BASE_URL=http://localhost:8000
